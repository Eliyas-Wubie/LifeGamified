#:kivy 2.3.0
#:import NoTransition kivy.uix.screenmanager.NoTransition
<MissionCenter>:
    orientation: "vertical"
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            orientation: "horizontal"
            padding:[20]
            size_hint_y: None
            height: 80
            canvas.before:
                Color:
                    rgba: 0,0,0,0.2
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20]
            Widget:
            TextInput:
                on_text: root.search(self.text)
                pos_hint: {"center_y":0.5}
                font_size: 16
                background_normal: ""
                background_active: ""
                background_color: 1, 1, 1, 0.2
                foreground_color: 1, 1, 1, 1
                cursor_color: 1, 1, 1, 1
                padding: [10,10]
                multiline: False
            Widget:
            Button:
                text: "Add new mission" if not root.add_form else "back to list"
                size_hint_y: None
                height: 45
                on_press: root.add_form = not root.add_form
                pos_hint: {"center_y":0.5}
                background_normal: "src/assets/grid2.jpg"
                background_down: "src/assets/grid4.jpg"

            Widget:
        ScreenManager:
            id: sm
            transition: NoTransition()
            Screen:
                name: "list"
                ScrollableList:
                    id: list
                    items: root.missions
                    control: root.delete
            # control: root.mission_control
            Screen:
                name: "form"
                BoxLayout:
                    orientation: "vertical"
                    canvas.before:
                        Color:
                            rgba: 0,0,0,0.2
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [20]
                    Widget:
                    BoxLayout:
                        orientation:"horizontal"
                        padding: 20
                        size_hint: 0.7, None
                        height: 80
                        pos_hint: {"center_x": 0.5}
                        Label:
                            text: "name *"
                            size_hint_x: None
                            width: max(self.texture_size[0] + dp(20), dp(120))
                            text_size: None, None
                        TextInput:
                            on_text: root.form_name = self.text
                            id: name
                            font_size: 16
                            background_normal: ""
                            background_active: ""
                            background_color: 1, 1, 1, 0.2
                            foreground_color: 1, 1, 1, 1
                            cursor_color: 1, 1, 1, 1
                            padding: [10,10]
                            multiline: False
                    Widget:
                    BoxLayout:
                        orientation:"horizontal"
                        padding: 20
                        size_hint: 0.7, None
                        height: 80
                        pos_hint: {"center_x": 0.5}
                        Label:
                            text: "description"
                            size_hint_x: None
                            width: max(self.texture_size[0] + dp(20), dp(120))
                            text_size: None, None
                        TextInput:
                            on_text: root.form_description = self.text
                            id: description
                            font_size: 16
                            background_normal: ""
                            background_active: ""
                            background_color: 1, 1, 1, 0.2
                            foreground_color: 1, 1, 1, 1
                            cursor_color: 1, 1, 1, 1
                            padding: [10,10]
                            multiline: False
                    Widget:
                    BoxLayout:
                        orientation:"horizontal"
                        padding: 20
                        size_hint: 0.7, None
                        height: 80
                        pos_hint: {"center_x": 0.5}
                        Label:
                            text: "difficulty"
                            size_hint_x: None
                            width: max(self.texture_size[0] + dp(20), dp(120))
                            text_size: None, None
                        Slider:
                            id: difficulty
                            min: 0
                            max: 10
                            value: 5
                            step: 1
                            on_value: root.form_difficulty = self.value
                    Widget:
                    BoxLayout:
                        orientation:"horizontal"
                        padding: 20
                        size_hint: 0.7, None
                        height: 80
                        pos_hint: {"center_x": 0.5}
                        Label:
                            text: "deadline"
                            size_hint_x: None
                            width: max(self.texture_size[0] + dp(20), dp(120))
                            text_size: None, None
                        BoxLayout:
                            spacing: 10

                            Spinner:
                                text: "Year"
                                values: [str(y) for y in range(2020, 2031)]
                                on_text: print("Selected year:", self.text)
                                background_normal: "src/assets/grid3.jpg"
                                id: year
                            Spinner:
                                text: "Month"
                                values: [str(m) for m in range(1, 13)]
                                on_text: print("Selected year:", self.text)
                                background_normal: "src/assets/grid3.jpg"
                                id: month
                            Spinner:
                                text: "Day"
                                values: [str(d) for d in range(1, 32)]
                                on_text: print("Selected year:", self.text)
                                background_normal: "src/assets/grid3.jpg"
                                id: day
                    Widget:
                    Button:
                        text:"submit"
                        size_hint_y: None
                        height: 80
                        on_press: root.submit()
                        background_normal: "src/assets/grid2.jpg"
                        background_active: "src/assets/grid4.jpg"


